# Kopieren nach .env und Werte fuer den Produktivbetrieb anpassen: cp .env.example .env

# Pflicht: starkes, zufaelliges Secret zum Signieren der Login-Tokens.
# Erzeugen z. B. mit: openssl rand -hex 32
JWT_SECRET=

# Optional: kommagetrennte Liste erlaubter Frontend-Origins fuer CORS, z. B.
# https://schichtplan.beispiel.de
# Leer gelassen (Standard) erlaubt die API jeden Origin -- fuer den Produktivbetrieb sollte hier
# die tatsaechliche Domain eingetragen werden, unter der das Frontend erreichbar ist.
CORS_ORIGIN=

# Optional: Port, unter dem der Reverse Proxy/Load Balancer das Frontend erreicht (Standard 80).
HTTP_PORT=80
